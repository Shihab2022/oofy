# ---------------------------------------------------------------
# OOFY — Environment variables
# Copy this file to .env and fill in the values before running.
# ---------------------------------------------------------------

# Application
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
PORT=5000

# PostgreSQL (use the docker-compose service or a managed DB)
DATABASE_URL=postgresql://oofy:oofy_password@localhost:5432/oofy?schema=public

# Admin account — created automatically by the database seed.
# Customer accounts are NOT required; only administrators log in.
ADMIN_NAME=OOFY Admin
ADMIN_EMAIL=admin@oofy.local
ADMIN_PASSWORD=OofyAdmin123!

# Company information
COMPANY_NAME=OOFY
COMPANY_EMAIL=oofybrand@gmail.com
COMPANY_PHONE=+8801XXXXXXXXX
COMPANY_ADDRESS=Dhaka, Bangladesh

# Email / SMTP (Nodemailer). Required for order notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=OOFY
SMTP_FROM_EMAIL=oofybrand@gmail.com

# JWT / Security
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1d
COOKIE_SECRET=change-me-to-a-cookie-signing-secret

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Delivery charges (BDT), configurable in admin Store Settings too
DELIVERY_FEE_DHAKA=80
DELIVERY_FEE_OUTSIDE_DHAKA=130

# Optional payment gateways — only enabled when credentials are provided
# Never simulate successful online payment without gateway verification.
BKASH_ENABLED=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

NAGAD_ENABLED=false
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
