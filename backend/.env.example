# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/oofy?schema=public"

# JWT Auth (admin only)
JWT_SECRET=change-this-super-secret-jwt-key-in-production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@oofy.com
ADMIN_PASSWORD=Admin@123

# Email (Nodemailer SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=noreply@oofy.com
SMTP_FROM_NAME=OOFY
COMPANY_EMAIL=oofybrand@gmail.com